<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>

<VBox fx:id="rootNode" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.sentencebuilder.ImportController"
      style="-fx-background-color: transparent;"
      prefWidth="1280" prefHeight="900">

    <!-- TOP NAV BAR -->
    <HBox fx:id="navBar" alignment="CENTER_LEFT" spacing="40"
          style="-fx-background-color: transparent; -fx-padding: 16 40 16 20;">

        <ImageView fx:id="logoImage" fitWidth="60" fitHeight="60" preserveRatio="true"/>

        <Region HBox.hgrow="ALWAYS"/>

        <HBox spacing="40" alignment="CENTER">
            <Label fx:id="navHome" text="Home"
                   style="-fx-font-size: 18px; -fx-padding: 4 0 4 0; -fx-cursor: hand;"
                   onMouseClicked="#handleHome"/>
            <Label fx:id="navSentenceGen" text="Sentence Gen"
                   style="-fx-font-size: 18px; -fx-padding: 4 0 4 0; -fx-cursor: hand;"
                   onMouseClicked="#handleSentenceGen"/>
            <Label fx:id="navAutoComplete" text="Auto-complete"
                   style="-fx-font-size: 18px; -fx-padding: 4 0 4 0; -fx-cursor: hand;"
                   onMouseClicked="#handleAutoComplete"/>
            <Label fx:id="navReports" text="Reports"
                   style="-fx-font-size: 18px; -fx-padding: 4 0 4 0; -fx-cursor: hand;"
                   onMouseClicked="#handleReports"/>
            <Label fx:id="navImport" text="Import"
                   style="-fx-font-size: 18px; -fx-padding: 4 0 4 0;"/>
            <Button fx:id="themeBtn"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #888888;
                           -fx-font-size: 13px;
                           -fx-cursor: hand;
                           -fx-border-color: #888888;
                           -fx-border-radius: 20;
                           -fx-background-radius: 20;
                           -fx-padding: 4 12 4 12;"/>
        </HBox>

    </HBox>

    <!-- MAIN CONTENT -->
    <VBox VBox.vgrow="ALWAYS" style="-fx-padding: 20 120 20 120;" spacing="24">

        <!-- IMPORT CARD -->
        <VBox fx:id="importCard" style="-fx-background-radius: 16; -fx-padding: 32;"
              alignment="CENTER" spacing="12">

            <Label text="Import a Text File"
                   style="-fx-font-size: 26px; -fx-font-weight: bold;"/>

            <Label text="Accepted format: plain text (.txt). Large files may take a moment."
                   wrapText="true" maxWidth="500"
                   style="-fx-font-size: 18px; -fx-text-alignment: center;"
                   alignment="CENTER"/>

            <VBox alignment="CENTER" spacing="10"
                  style="-fx-background-radius: 12;
                         -fx-padding: 40; -fx-min-width: 400;">

                <Label text="⬆" style="-fx-font-size: 36px;"/>
                <Label fx:id="dropLabel" text="Drop a .txt file here"
                       style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                <Label text="or click to browse your computer"
                       style="-fx-font-size: 13px;"/>

                <Button text="Choose File" onAction="#handleChooseFile"
                        style="-fx-font-size: 14px;
                               -fx-padding: 10 24 10 24;
                               -fx-background-radius: 20;
                               -fx-cursor: hand;"/>
            </VBox>
        </VBox>

        <!-- IMPORT HISTORY CARD -->
        <VBox fx:id="historyCard" style="-fx-background-radius: 16; -fx-padding: 32;"
              VBox.vgrow="ALWAYS" spacing="12">

            <Label text="Import History"
                   style="-fx-font-size: 26px; -fx-font-weight: bold;"
                   maxWidth="Infinity" alignment="CENTER"/>

            <HBox style="-fx-border-width: 0 0 1 0; -fx-padding: 0 0 8 0;">
                <Label text="File Name" prefWidth="300"
                       style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                <Label text="Words" prefWidth="150"
                       style="-fx-font-size: 14px;"/>
                <Label text="Imported On" prefWidth="150"
                       style="-fx-font-size: 14px;"/>
                <Label text="Status"
                       style="-fx-font-size: 14px;"/>
            </HBox>

            <VBox fx:id="importHistoryList" spacing="4">
                <Label text="No files imported yet. Import your first file above."
                       style="-fx-font-size: 14px; -fx-padding: 16 0 0 0;"
                       maxWidth="Infinity" alignment="CENTER"/>
            </VBox>

        </VBox>

    </VBox>

</VBox>