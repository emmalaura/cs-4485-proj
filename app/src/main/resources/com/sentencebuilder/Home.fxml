<?xml version="1.0" encoding="UTF-8"?>
<!-- // Written by: Emma Gonzalez -->
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>

<VBox fx:id="rootNode" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.sentencebuilder.HomeController"
      style="-fx-background-color: transparent;"
      prefWidth="1280" prefHeight="900">

    <!-- TOP NAV BAR -->
    <HBox fx:id="navBar" alignment="CENTER_LEFT" spacing="40"
          style="-fx-background-color: transparent; -fx-padding: 16 40 16 20;"
          prefWidth="Infinity">
        <ImageView fx:id="logoImage" fitWidth="70" fitHeight="70" preserveRatio="true"/>

        <Region HBox.hgrow="ALWAYS"/>

        <HBox spacing="40" alignment="CENTER">
            <Label fx:id="navHome" text="Home"
                   style="-fx-font-size: 18px; -fx-padding: 4 0 4 0;"/>
            <Label fx:id="navSentenceGen" text="Sentence Gen"
                   style="-fx-font-size: 18px; -fx-padding: 4 0 4 0;"
                   onMouseClicked="#handleSentenceGen"/>
            <Label fx:id="navAutoComplete" text="Auto-complete"
                   style="-fx-font-size: 18px; -fx-padding: 4 0 4 0;"
                   onMouseClicked="#handleAutoComplete"/>
            <Label fx:id="navReports" text="Reports"
                   style="-fx-font-size: 18px; -fx-padding: 4 0 4 0;"
                   onMouseClicked="#handleReports"/>
            <Label fx:id="navImport" text="Import"
                   style="-fx-font-size: 18px; -fx-padding: 4 0 4 0;"
                   onMouseClicked="#handleImport"/>
            <Button fx:id="themeBtn"
                    style="-fx-background-color: transparent;
                       -fx-text-fill: #888888;
                       -fx-font-size: 13px;
                       -fx-cursor: hand;
                       -fx-border-color: #888888;
                       -fx-border-radius: 20;
                       -fx-background-radius: 20;
                       -fx-padding: 4 12 4 12;"/>
        </HBox>
    </HBox>

    <!-- SPACER TOP -->
    <Region VBox.vgrow="ALWAYS"/>

    <!-- CENTER CONTENT -->
    <VBox alignment="CENTER" spacing="24" fillWidth="true">

        <Label fx:id="welcomeTitle" text="Welcome to Auto Glossary!"
               style="-fx-font-size: 32px; -fx-font-weight: bold;"
               maxWidth="Infinity"
               alignment="CENTER"/>

        <Label fx:id="welcomeSubtitle" text="Auto Glossary is here for all of your technical knowledge. It is trained on reputable technical knowledge from sources such as textbooks, manuals, etc."
               wrapText="true"
               maxWidth="660"
               style="-fx-font-size: 18px; -fx-text-alignment: center;"
               alignment="CENTER"/>

        <HBox alignment="CENTER">
            <Button fx:id="generateBtn" text="Generate a sentence"
                    onAction="#handleGenerate"
                    style="-fx-font-size: 16px;
                           -fx-padding: 16 40 16 40;
                           -fx-background-radius: 12;
                           -fx-cursor: hand;"/>
        </HBox>

    </VBox>

    <!-- SPACER BOTTOM -->
    <Region VBox.vgrow="ALWAYS"/>

</VBox>