<?xml version="1.0" encoding="UTF-8"?>
<!-- // Written by: Emma Gonzalez -->
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>

<VBox fx:id="rootNode" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.sentencebuilder.ReportsController"
      style="-fx-background-color: transparent;"
      prefWidth="1280" prefHeight="900">

    <!-- TOP NAV BAR -->
    <HBox fx:id="navBar" alignment="CENTER_LEFT" spacing="40"
          style="-fx-background-color: transparent; -fx-padding: 16 40 16 20;"
          prefWidth="Infinity">

        <ImageView fx:id="logoImage" fitWidth="60" fitHeight="60" preserveRatio="true"/>

        <Region HBox.hgrow="ALWAYS"/>

        <HBox spacing="40" alignment="CENTER">
            <Label text="Home" style="-fx-font-size: 16px; -fx-cursor: hand;"
                   fx:id="navHome" onMouseClicked="#handleHome"/>
            <Label text="Sentence Gen" style="-fx-font-size: 16px; -fx-cursor: hand;"
                   fx:id="navSentenceGen" onMouseClicked="#handleSentenceGen"/>
            <Label text="Auto-complete" style="-fx-font-size: 16px; -fx-cursor: hand;"
                   fx:id="navAutoComplete" onMouseClicked="#handleAutoComplete"/>
            <Label fx:id="navReports" text="Reports"
                   style="-fx-font-size: 18px; -fx-padding: 4 0 4 0;"/>
            <Label text="Import" style="-fx-font-size: 16px; -fx-cursor: hand;"
                   fx:id="navImport" onMouseClicked="#handleImport"/>
            <Button fx:id="themeBtn"
                    style="-fx-background-color: transparent;
                       -fx-text-fill: #888888;
                       -fx-font-size: 13px;
                       -fx-cursor: hand;
                       -fx-border-color: #888888;
                       -fx-border-radius: 20;
                       -fx-background-radius: 20;
                       -fx-padding: 4 12 4 12;"/>
        </HBox>

    </HBox>

    <!-- SCROLLABLE MAIN CONTENT -->
    <ScrollPane VBox.vgrow="ALWAYS" fitToWidth="true"
                style="-fx-background-color: transparent; -fx-background: transparent;
                       -fx-border-color: transparent;">
        <VBox spacing="24" style="-fx-padding: 10 120 40 120;">

            <Label fx:id="reportsTitle" text="Reports"
                   style="-fx-font-size: 32px; -fx-font-weight: bold;"/>

            <VBox fx:id="wordListCard" style="-fx-background-radius: 16; -fx-padding: 32;"
                  spacing="12">
                <HBox alignment="CENTER_LEFT" spacing="16">
                    <Label fx:id="wordListTitle" text="Word List"
                           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Sort by:" style="-fx-font-size: 14px;"/>
                    <ComboBox fx:id="sortSelector"
                              style="-fx-background-radius: 8; -fx-font-size: 13px;"
                              prefWidth="200"/>
                </HBox>

                <HBox style="-fx-border-width: 0 0 1 0; -fx-padding: 0 0 8 0;">
                    <Label text="Word" prefWidth="250"
                           style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <Label text="Frequency" prefWidth="150"
                           style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <Label text="Date Added" prefWidth="180"
                           style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <Label text="Source File"
                           style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                </HBox>

                <VBox fx:id="wordListContainer" spacing="0"/>
            </VBox>

            <VBox fx:id="sentenceCard" style="-fx-background-radius: 16; -fx-padding: 32;"
                  spacing="12">
                <Label fx:id="sentenceTitle" text="Generated Sentences"
                       style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

                <HBox style="-fx-border-width: 0 0 1 0; -fx-padding: 0 0 8 0;">
                    <Label text="Sentence" prefWidth="700"
                           style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <Label text="Date" prefWidth="120"
                           style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <Label text="Status"
                           style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                </HBox>

                <VBox fx:id="sentenceListContainer" spacing="0"/>
            </VBox>

        </VBox>
    </ScrollPane>

</VBox>