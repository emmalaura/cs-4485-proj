<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.sentencebuilder.ReportsController"
      style="-fx-background-color: #D9D9D9;"
      prefWidth="1280" prefHeight="900">

    <!-- TOP NAV BAR -->
    <HBox alignment="CENTER" spacing="40"
          style="-fx-background-color: #D9D9D9; -fx-padding: 16 40 16 40;">

        <ImageView fx:id="logoImage" fitWidth="60" fitHeight="60" preserveRatio="true"/>

        <Region HBox.hgrow="ALWAYS"/>

        <HBox spacing="40" alignment="CENTER">
            <Label text="Home" style="-fx-font-size: 16px; -fx-text-fill: #1a1a1a; -fx-cursor: hand;"
                   fx:id="navHome" onMouseClicked="#handleHome"/>
            <Label text="Sentence Gen" style="-fx-font-size: 16px; -fx-text-fill: #1a1a1a; -fx-cursor: hand;"
                   fx:id="navSentenceGen" onMouseClicked="#handleSentenceGen"/>
            <Label text="Auto-complete" style="-fx-font-size: 16px; -fx-text-fill: #1a1a1a; -fx-cursor: hand;"
                   fx:id="navAutoComplete" onMouseClicked="#handleAutoComplete"/>
            <Label text="Reports" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
            <Label text="Import" style="-fx-font-size: 16px; -fx-text-fill: #1a1a1a; -fx-cursor: hand;"
                   fx:id="navImport" onMouseClicked="#handleImport"/>
        </HBox>

    </HBox>

    <!-- SCROLLABLE MAIN CONTENT -->
    <ScrollPane VBox.vgrow="ALWAYS" fitToWidth="true"
                style="-fx-background-color: transparent; -fx-background: transparent;
                       -fx-border-color: transparent;">
        <VBox spacing="24" style="-fx-padding: 10 120 40 120;">

            <!-- PAGE TITLE -->
            <Label text="Reports"
                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"
                   maxWidth="Infinity" alignment="CENTER"/>

            <!-- WORD LIST CARD -->
            <VBox style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 32;"
                  spacing="12">

                <!-- Card Header -->
                <HBox alignment="CENTER_LEFT" spacing="16">
                    <Label text="Word List"
                           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Sort by:" style="-fx-font-size: 14px; -fx-text-fill: #555555;"/>
                    <ComboBox fx:id="sortSelector"
                              style="-fx-background-radius: 8; -fx-font-size: 13px;"
                              prefWidth="200"/>
                </HBox>

                <!-- Table Header -->
                <HBox style="-fx-border-color: #1a1a1a; -fx-border-width: 0 0 1 0; -fx-padding: 0 0 8 0;">
                    <Label text="Word" prefWidth="250"
                           style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <Label text="Frequency" prefWidth="150"
                           style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <Label text="Date Added" prefWidth="180"
                           style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <Label text="Source File"
                           style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                </HBox>

                <!-- Word Rows -->
                <VBox fx:id="wordListContainer" spacing="0"/>

            </VBox>

            <!-- GENERATED SENTENCES CARD -->
            <VBox style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 32;"
                  spacing="12">

                <!-- Card Header -->
                <Label text="Generated Sentences"
                       style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>

                <!-- Table Header -->
                <HBox style="-fx-border-color: #1a1a1a; -fx-border-width: 0 0 1 0; -fx-padding: 0 0 8 0;">
                    <Label text="Sentence" prefWidth="700"
                           style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <Label text="Date" prefWidth="120"
                           style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <Label text="Status"
                           style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                </HBox>

                <!-- Sentence Rows -->
                <VBox fx:id="sentenceListContainer" spacing="0"/>

            </VBox>

        </VBox>
    </ScrollPane>

</VBox>