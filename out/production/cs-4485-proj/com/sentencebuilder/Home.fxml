<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.sentencebuilder.HomeController"
      style="-fx-background-color: #D9D9D9;"
      prefWidth="1280" prefHeight="900">

    <!-- TOP NAV BAR -->
    <HBox alignment="CENTER" spacing="40"
          style="-fx-background-color: #D9D9D9; -fx-padding: 16 40 16 40;">

        <ImageView fx:id="logoImage" fitWidth="60" fitHeight="60" preserveRatio="true"/>

        <Region HBox.hgrow="ALWAYS"/>

        <HBox spacing="40" alignment="CENTER">
            <Label text="Home" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
            <Label text="Sentence Gen" style="-fx-font-size: 16px; -fx-text-fill: #1a1a1a; -fx-cursor: hand;"
                   fx:id="navSentenceGen" onMouseClicked="#handleSentenceGen"/>
            <Label text="Auto-complete" style="-fx-font-size: 16px; -fx-text-fill: #1a1a1a; -fx-cursor: hand;"
                   fx:id="navAutoComplete" onMouseClicked="#handleAutoComplete"/>
            <Label text="Reports" style="-fx-font-size: 16px; -fx-text-fill: #1a1a1a; -fx-cursor: hand;"
                   fx:id="navReports" onMouseClicked="#handleReports"/>
            <Label text="Import" style="-fx-font-size: 16px; -fx-text-fill: #1a1a1a; -fx-cursor: hand;"
                   fx:id="navImport" onMouseClicked="#handleImport"/>
        </HBox>

    </HBox>
    <!-- SPACER TOP -->
    <Region VBox.vgrow="ALWAYS"/>

    <!-- CENTER CONTENT -->
    <VBox alignment="CENTER" spacing="24" fillWidth="true">

        <Label text="Welcome to Auto Glossary!"
               style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"
               maxWidth="Infinity"
               alignment="CENTER"/>

        <Label text="Auto Glossary is here for all of your technical knowledge. It is trained on reputable technical knowledge from sources such as textbooks, manuals, etc."
               wrapText="true"
               maxWidth="660"
               style="-fx-font-size: 18px; -fx-text-fill: #888888; -fx-text-alignment: center;"
               alignment="CENTER"/>

        <HBox alignment="CENTER">
            <Button fx:id="generateBtn" text="Generate a sentence"
                    onAction="#handleGenerate"
                    style="-fx-background-color: #2b2b2b;
                           -fx-text-fill: white;
                           -fx-font-size: 16px;
                           -fx-padding: 16 40 16 40;
                           -fx-background-radius: 12;
                           -fx-cursor: hand;"/>
        </HBox>

    </VBox>

    <!-- SPACER BOTTOM -->
    <Region VBox.vgrow="ALWAYS"/>

</VBox>